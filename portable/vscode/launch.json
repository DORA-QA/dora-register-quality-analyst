{
  // Optional: F5 needs the Microsoft Python extension. Without it, use the tasks
  // (Terminal > Run Task... > "2 - Lancer DORA QA").
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lancer DORA QA",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/portable/launcher.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
